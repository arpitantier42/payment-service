DATABASE_URL=postgres://orders:orders@localhost:5433/orders
ORDER_SERVICE_PORT=3001
# Comma-separated bearer tokens accepted by order-service (placeholder for a real IdP)
ORDER_SERVICE_BEARER_TOKENS=dev-token
# Comma-separated X-API-Key values accepted on internal endpoints (PATCH /orders/{id}/status)
ORDER_SERVICE_API_KEYS=dev-internal-key

# --- payment-service (its DATABASE_URL points at payment-db, e.g. postgres://payments:payments@localhost:5434/payments)
PAYMENT_SERVICE_PORT=3002
PAYMENT_SERVICE_BEARER_TOKENS=dev-token
# order-service base URL and the bearer token payment-service uses for GET /orders/{id}
ORDER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_TOKEN=dev-token
# X-API-Key payment-service uses for PATCH /orders/{id}/status (must be in ORDER_SERVICE_API_KEYS)
ORDER_SERVICE_API_KEY=dev-internal-key
ORDER_SERVICE_TIMEOUT_MS=3000
# mock (offline, accepts every checkout) | razorpay | stripe (generic HTTP adapter, needs PAYMENT_GATEWAY_BASE_URL)
PAYMENT_GATEWAY_NAME=mock
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_TIMEOUT_MS=10000
PAYMENT_GATEWAY_RETRY_ATTEMPTS=3
PAYMENT_GATEWAY_RETRY_BASE_DELAY_MS=200
CHECKOUT_SESSION_TTL_MINUTES=15
# Gateway credentials are only ever configured encrypted (AES-256-GCM). Produce the value with
#   SECRETS_MASTER_KEY=... npm run encrypt-secret -- '{"key_id":"...","key_secret":"..."}'
# The pair below is a DEV-ONLY sample that decrypts to dev placeholder credentials.
SECRETS_MASTER_KEY=i89Af/rOfrSD/yBWGLojMxsL/8HpyZFtsuQGXCEs0m0=
PAYMENT_GATEWAY_CREDENTIALS_ENCRYPTED=v1.Nnw6FhU1dlKO7axY.zFDG6IaY1UYfPWvvMX3fJw.gOhVSLLqsX5qzWBm53qAezq-51DQht_ruCwQgOjiaxVKxFZ_rCjoBsmEo8nh2VU0_eeZLcM
# HMAC secret the gateway signs webhooks (X-Gateway-Signature) with, sealed the same way:
#   SECRETS_MASTER_KEY=... npm run encrypt-secret -- '<webhook signing secret>'
PAYMENT_GATEWAY_WEBHOOK_SECRET_ENCRYPTED=v1.603TQl1HE8P2Bhhx.oEl-aUVONF4glRrJAY5Pww.vK2YArmivX0Jjp-gIREuFS7IV6wfTrt37A4

# --- reconciliation-worker (DATABASE_URL -> payment-db; also reads ORDER_SERVICE_URL,
# ORDER_SERVICE_API_KEY, ORDER_SERVICE_TIMEOUT_MS, PAYMENT_GATEWAY_* and SECRETS_MASTER_KEY above)
RECONCILIATION_WORKER_PORT=3003
# Comma-separated X-API-Key values the scheduler presents to POST /internal/payments/*-runs
RECONCILIATION_WORKER_API_KEYS=dev-scheduler-key
# Payments INITIATED/PENDING with no status change for this long are polled at the gateway
RECONCILIATION_THRESHOLD_MINUTES=10
# In-process schedule; 0 = only run when triggered over HTTP (e.g. by a Kubernetes CronJob)
RECONCILIATION_INTERVAL_MINUTES=15
RECONCILIATION_BATCH_SIZE=100
# Session expiry (POST /internal/payments/session-expiry-runs): ACTIVE checkout sessions past
# expires_at + grace are expired with their payment. 0 interval = only HTTP-triggered.
SESSION_EXPIRY_INTERVAL_MINUTES=5
SESSION_EXPIRY_GRACE_SECONDS=60
# mock gateway only: transaction state it reports (created | captured | failed | expired ...)
MOCK_GATEWAY_TRANSACTION_STATUS=created
# mock gateway only (payment-service): checkout_url base the browser is redirected to; the
# customer-client's dev hosted-checkout page (needs MOCK_CHECKOUT_ENABLED=true there)
MOCK_GATEWAY_CHECKOUT_BASE_URL=http://localhost:3000/mock-checkout

# --- customer-client (browser UI + same-origin /api; uses ORDER_SERVICE_URL above)
CUSTOMER_CLIENT_PORT=3000
PAYMENT_SERVICE_URL=http://localhost:3002
# Bearer tokens the client's server side presents (never sent to the browser)
CUSTOMER_CLIENT_ORDER_SERVICE_TOKEN=dev-token
CUSTOMER_CLIENT_PAYMENT_SERVICE_TOKEN=dev-token
CUSTOMER_CLIENT_UPSTREAM_TIMEOUT_MS=10000
# DEV ONLY: serve /mock-checkout (stand-in for the gateway's hosted page; signs webhooks with
# PAYMENT_GATEWAY_WEBHOOK_SECRET_ENCRYPTED + SECRETS_MASTER_KEY). Never enable with a real gateway.
MOCK_CHECKOUT_ENABLED=true
# Where /mock-checkout delivers the webhook (default: PAYMENT_SERVICE_URL/webhooks/payments)
MOCK_CHECKOUT_WEBHOOK_URL=
