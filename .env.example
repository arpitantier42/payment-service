DATABASE_URL=postgres://orders:orders@localhost:5433/orders
ORDER_SERVICE_PORT=3001
# Comma-separated bearer tokens accepted by order-service (placeholder for a real IdP)
ORDER_SERVICE_BEARER_TOKENS=dev-token
# Comma-separated X-API-Key values accepted on internal endpoints (PATCH /orders/{id}/status)
ORDER_SERVICE_API_KEYS=dev-internal-key

# --- payment-service (its DATABASE_URL points at payment-db, e.g. postgres://payments:payments@localhost:5434/payments)
PAYMENT_SERVICE_PORT=3002
PAYMENT_SERVICE_BEARER_TOKENS=dev-token
# order-service base URL and the bearer token payment-service uses for GET /orders/{id}
ORDER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_TOKEN=dev-token
ORDER_SERVICE_TIMEOUT_MS=3000
# mock (offline, accepts every checkout) | razorpay | stripe (generic HTTP adapter, needs PAYMENT_GATEWAY_BASE_URL)
PAYMENT_GATEWAY_NAME=mock
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_TIMEOUT_MS=10000
PAYMENT_GATEWAY_RETRY_ATTEMPTS=3
PAYMENT_GATEWAY_RETRY_BASE_DELAY_MS=200
CHECKOUT_SESSION_TTL_MINUTES=15
# Gateway credentials are only ever configured encrypted (AES-256-GCM). Produce the value with
#   SECRETS_MASTER_KEY=... npm run encrypt-secret -- '{"key_id":"...","key_secret":"..."}'
# The pair below is a DEV-ONLY sample that decrypts to dev placeholder credentials.
SECRETS_MASTER_KEY=i89Af/rOfrSD/yBWGLojMxsL/8HpyZFtsuQGXCEs0m0=
PAYMENT_GATEWAY_CREDENTIALS_ENCRYPTED=v1.Nnw6FhU1dlKO7axY.zFDG6IaY1UYfPWvvMX3fJw.gOhVSLLqsX5qzWBm53qAezq-51DQht_ruCwQgOjiaxVKxFZ_rCjoBsmEo8nh2VU0_eeZLcM
